# Copy this file to ".env" and fill in real values before running `docker compose up`.
# ".env" is git-ignored - never commit real secrets.
#
# Nested appsettings keys are set with ASP.NET Core's "__" separator,
# e.g. "RabbitMQ": { "UserName": "x" } -> RabbitMQ__UserName=x

# ------------------------------------------------------------------
# Build
# ------------------------------------------------------------------
# Token used by the Dockerfile to restore the private GitHub NuGet feed.
GITHUB_TOKEN=

# ------------------------------------------------------------------
# Postgres (postgresdb container + SubsTracker.API/SubsTracker.Hangfire)
# ------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=substracker
PostgreConnectionString=Host=postgresdb;Port=5432;Database=substracker;Username=postgres;Password=postgres

# ------------------------------------------------------------------
# MongoDB (mongodb container + SubsTracker.Hangfire storage)
# ------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MongoDbConnectionString=mongodb://root:root@mongodb:27017
Hangfire__DatabaseName=substracker_hangfire
Hangfire__CollectionName=jobs

# ------------------------------------------------------------------
# RabbitMQ (rabbitmq container + MassTransit)
# ------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RabbitMQ__HostName=rabbitmq
RabbitMQ__VirtualHostName=/
RabbitMQ__UserName=guest
RabbitMQ__Password=guest

# ------------------------------------------------------------------
# Auth0
# ------------------------------------------------------------------
Auth0__Domain=
Auth0__ClientId=
Auth0__ClientSecret=
Auth0__Audience=
Auth0__Authority=
Auth0__ManagementApiUrl=

# ------------------------------------------------------------------
# CORS / Cookie
# ------------------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:3000
Cors__ContentDisposition=attachment

Cookie__Name=substracker.auth
Cookie__HttpOnly=true
Cookie__SameSite=Lax
Cookie__SecurePolicy=SameAsRequest
Cookie__Path=/
Cookie__IsEssential=true
Cookie__Domain=localhost
Cookie__ExpirationTimeSpan=14
Cookie__SlidingExpiration=true

# ------------------------------------------------------------------
# Resilience (Retry / CircuitBreaker / CapacityLimiter)
# ------------------------------------------------------------------
Retry__MaxRetryAttempts=3
Retry__SecondsTimeout=30
Retry__BaseDelaySeconds=1

CircuitBreaker__FailureRatio=0.5
CircuitBreaker__SamplingDuration=30
CircuitBreaker__MinimumThroughput=10
CircuitBreaker__BreakDuration=30

CapacityLimiter__PermitLimit=100
CapacityLimiter__RequestWindow=10
CapacityLimiter__SegmentsPerWindow=2

# ------------------------------------------------------------------
# Elastic Stack - Elasticsearch / Logstash / Kibana
# ------------------------------------------------------------------
# Single-node dev setup, security disabled (see docker-compose.yaml).
# Set ELASTIC_PASSWORD and enable xpack.security if you turn auth back on.
ELASTIC_PASSWORD=
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Read by SubsTracker.API / SubsTracker.Hangfire (Serilog -> Logstash TCP/JSON sink).
# Leave Logstash__Host empty to disable log shipping (e.g. local dev without ELK running).
Logstash__Host=logstash
Logstash__Port=5000
